<mvc:View
    controllerName="zdomscrapmovements.controller.UcDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns="sap.m"
    displayBlock="true"
    height="100%"
    busyIndicatorDelay="0"
>
    <Page
        title="UC Detail"
        showNavButton="true"
        navButtonPress="onNavBack"
    >
        <t:Table
            id="table"
            rows="{ucDetailModel>/selectedData}"
            rowSelectionChange="onSelectionChange"
            class="zHorizontalScrollTable"
        >
            <t:extension>
                <Toolbar id="_IDGenToolbarDetail">
                    <Title text="UC Data">
                        <content />
                    </Title>
                    <ToolbarSpacer />
                    <Button
                        id="scrapToFreeBtn"
                        type="Accept"
                        icon="sap-icon://initiative"
                        enabled="false"
                        tooltip="{i18n>scrapToFree}"
                        text="{i18n>scrapToFree}"
                        press="onScrapToFreeButtonPress"
                    />
                    <Button
                        id="MassFillFields"
                        type="Transparent"
                        icon="sap-icon://add-process"
                        press="onValueHelpMassFillDialog"
                        enabled="false"
                        tooltip="{i18n>massFill}"
                        text="{i18n>massFillText}"
                    />
                    <Button
                        press=".onExportExcel"
                        icon="sap-icon://excel-attachment"
                    />
                </Toolbar>
            </t:extension>

            <t:columns>
                <t:Column
                    sortProperty="BlockedStock"
                    filterProperty="BlockedStock"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>blockedQty}" />
                    </t:label>
                    <t:template>
                        <Text
                            id="blockedQty"
                            text="{
                                path: 'ucDetailModel>BlockedStock',
                                type: 'sap.ui.model.type.Float',
                                formatOptions: {
                                    minFractionDigits: 3,
                                    maxFractionDigits: 3,
                                    groupingEnabled: true
                                }
                            }"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="ScrapQuantity"
                    filterProperty="ScrapQuantity"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>scrapQty}" />
                    </t:label>
                    <t:template>
                        <Input
                            id="scrapQty"
                            value="{
                                path: 'ucDetailModel>ScrapQuantity',
                                type: 'sap.ui.model.type.Float',
                                formatOptions: {
                                    minFractionDigits: 3,
                                    maxFractionDigits: 3,
                                    groupingEnabled: true
                                },
                                constraints: {
                                    minimum: 0
                                }
                            }"
                            change="onFormatValue"
                            maxLength="5"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="FreeQuantity"
                    filterProperty="FreeQuantity"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>freeQty}" />
                    </t:label>
                    <t:template>
                        <Input
                            id="freeQty"
                            value="{
                                path: 'ucDetailModel>FreeQuantity',
                                type: 'sap.ui.model.type.Float',
                                formatOptions: {
                                    minFractionDigits: 3,
                                    maxFractionDigits: 3,
                                    groupingEnabled: true
                                },
                                constraints: {
                                    minimum: 0
                                }
                            }"
                            change="onFormatValue"
                            maxLength="5"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="Reason"
                    filterProperty="Reason"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>reason}" />
                    </t:label>
                    <t:template>
                        <Input
                            id="Reason"
                            type="Number"
                            showValueHelp="true"
                            valueHelpRequest="onValueHelpRequestInputsTable"
                            change="onInputChange"
                            maxLength="4"
                            value="{ucDetailModel>Reason}"
                            valueState="{ucDetailModel>ReasonState}"
                            valueStateText="{ucDetailModel>ReasonStateText}"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="CostCenter"
                    filterProperty="CostCenter"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>costCenter}" />
                    </t:label>
                    <t:template>
                        <Input
                            id="CostCenter"
                            showValueHelp="true"
                            valueHelpRequest="onValueHelpRequestInputsTable"
                            change="onInputChange"
                            value="{ucDetailModel>CostCenter}"
                            valueState="{ucDetailModel>CostCenterState}"
                            valueStateText="{ucDetailModel>CostCenterStateText}"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="HigherLevelHu"
                    filterProperty="HigherLevelHu"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>higherLevelHu}" />
                    </t:label>
                    <t:template>
                        <Text text="{ucDetailModel>HigherLevelHu}" />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="HandlingUnit"
                    filterProperty="HandlingUnit"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>handlingUnit}" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{
                            path: 'ucDetailModel>HandlingUnit',
                            formatter: '.formatter.cleanCeros'
                        }"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="HuIdentification"
                    filterProperty="HuIdentification"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>huIdentification}" />
                    </t:label>
                    <t:template>
                        <Text text="{ucDetailModel>HuIdentification}" />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="Serid"
                    filterProperty="Serid"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>serId}" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{
                            path: 'ucDetailModel>Serid',
                            formatter: '.formatter.cleanCeros'
                        }"
                        />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="StorageBin"
                    filterProperty="StorageBin"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>storageBin}" />
                    </t:label>
                    <t:template>
                        <Text text="{ucDetailModel>StorageBin}" />
                    </t:template>
                </t:Column>

                <t:Column
                    sortProperty="Weight"
                    filterProperty="Weight"
                    showSortMenuEntries="true"
                    showFilterMenuEntries="true"
                >
                    <t:label>
                        <Label text="{i18n>weight}" />
                    </t:label>
                    <t:template>
                        <Text
                            text="{ucDetailModel>Weight} {ucDetailModel>WeightUnit}"
                        />
                    </t:template>
                </t:Column>
            </t:columns>
        </t:Table>

        <footer>
            <OverflowToolbar>
                <Button
                    id="messagePopoverBtn"
                    icon="sap-icon://notification-2"
                    text="{popoverModel>/messageLength}"
                    type="{popoverModel>/type}"
                    press=".handleMessagePopoverPress"
                    ariaHasPopup="Dialog"
                    enabled="false"
                />
                <ToolbarSpacer />
                <Button
                    id="stockTransferBtn"
                    class="sapUiSmallMarginBeginEnd"
                    text="{i18n>stockTransferBtn}"
                    enabled="false"
                    press="openPrintLabels"
                    type="Emphasized"
                >
                    <customData>
                        <core:CustomData
                            key="multi"
                            value="true"
                        />
                        <core:CustomData
                            key="remember"
                            value="true"
                        />
                        <core:CustomData
                            key="draggable"
                            value="true"
                        />
                    </customData>
                </Button>
            </OverflowToolbar>
        </footer>
    </Page>
</mvc:View>
